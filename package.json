{
  "name": "meeting-calendar",
  "version": "1.0.0",
  "description": "A meeting calendar for WordPress.org",
  "main": "index.js",
  "scripts": {
    "build": "wp-scripts build index=./src/index.js calendar=./src/frontend/index.js",
    "check-engines": "wp-scripts check-engines",
    "check-licenses": "wp-scripts check-licenses",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "lint:md:docs": "wp-scripts lint-md-docs",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "packages-update": "wp-scripts packages-update",
    "start": "wp-scripts start index=./src/index.js calendar=./src/frontend/index.js",
    "test:unit-php": "wp-env --config=.wp-env.test.json run cli --env-cwd=wp-content/plugins/meeting-calendar vendor/bin/phpunit",
    "wp-env": "wp-env",
    "wp-env:test": "wp-env --config=.wp-env.test.json",
    "format": "wp-scripts format ./src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WordPress/meeting-calendar.git"
  },
  "author": "",
  "license": "GPL-2.0-or-later",
  "bugs": {
    "url": "https://github.com/WordPress/meeting-calendar/issues"
  },
  "homepage": "https://github.com/WordPress/meeting-calendar#readme",
  "devDependencies": {
    "@wordpress/env": "^12.0.0",
    "@wordpress/scripts": "^37.0.0"
  }
}
